// Cloudflare Worker that serves the static website in site/. No server code.
{
  // Must match the project name in the Cloudflare dashboard.
  "name": "handoff-bar",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./site"
  },
  // Cloudflare creates the DNS record and certificate on deploy.
  "routes": [{ "pattern": "handoffbar.proxylang.dev", "custom_domain": true }]
}
