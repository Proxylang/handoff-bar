<?xml version="1.0" encoding="utf-8"?>
<!-- Microsoft Store package for HandoffBar. package.ps1 fills in the {{...}} values:
     the three identity values come from Partner Center (Product identity page). -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 desktop rescap">

  <Identity Name="{{IdentityName}}" Publisher="{{Publisher}}" Version="{{Version}}" ProcessorArchitecture="neutral" />

  <Properties>
    <DisplayName>HandoffBar</DisplayName>
    <PublisherDisplayName>{{PublisherDisplayName}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Saves a handoff prompt before a Claude Code chat's cache expires. Click it to copy it into a new chat.</Description>
  </Properties>

  <Dependencies>
    <!-- Windows 10 version 1809 and later, the oldest that runs startup tasks for desktop apps. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="HandoffBar" Executable="HandoffBar.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="HandoffBar" Description="Claude Code chat handoffs"
        BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- Starts with Windows. The user can turn it off in Task Manager > Startup apps. -->
        <uap5:Extension Category="windows.startupTask">
          <uap5:StartupTask TaskId="HandoffBarStartup" Enabled="true" DisplayName="HandoffBar" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- A normal desktop app: it reads and writes the user's .claude folder. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
